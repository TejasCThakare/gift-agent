# ──────────────────────────────────────────────────────────────────────────────
# Gift Agent — Environment Configuration
# Copy this file to .env and fill in values as needed.
# ──────────────────────────────────────────────────────────────────────────────

# LLM Provider priority: ollama → groq → gemini
# The application auto-detects availability and falls back in this order.
# Ollama requires no key — just have it running with qwen3 pulled.
# Groq and Gemini are optional enhancements.

# ── Ollama (primary — no key required) ──────────────────────────────────────
# Default model. Must be pulled: ollama pull qwen3
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3

# ── Groq (fallback #1 — free tier, generous limits) ──────────────────────────
# Get a free key at https://console.groq.com
# Leave blank to skip Groq.
GROQ_API_KEY=

# ── Gemini (fallback #2 — free tier) ─────────────────────────────────────────
# Get a free key at https://aistudio.google.com
# Leave blank to skip Gemini.
GEMINI_API_KEY=

# ── Application settings ─────────────────────────────────────────────────────
# Bind address for the FastAPI server
API_HOST=0.0.0.0
API_PORT=8000

# Directory for persisted workflow artifacts (auto-created)
ARTIFACTS_DIR=artifacts

# Maximum search results per query (total capped at 15 across all queries)
MAX_SEARCH_RESULTS_PER_QUERY=5

# URL validation timeout in seconds
URL_VALIDATION_TIMEOUT=5

# Validation score threshold to consider a product "passing"
# Products below this threshold are "partial" pass
VALIDATION_PASS_THRESHOLD=0.75
VALIDATION_PARTIAL_THRESHOLD=0.40

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
